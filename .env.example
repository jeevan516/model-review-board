# Copy this file to .env for local development. Never commit .env.

# Leave DATABASE_URL unset to use the local SQLite file in instance/reviews.db.
# To try PostgreSQL locally, use a URL like the placeholder below.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/model_reviews

# Any long random string. Render generates its own value in production.
SECRET_KEY=change-me-for-local-development
